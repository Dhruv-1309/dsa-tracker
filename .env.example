# ==========================================
# DSA Tracker Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file with real secrets to version control!

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
# Full JDBC URL (optional, overrides host/port/name if provided)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
# DATABASE_URL=jdbc:postgresql://localhost:5432/postgres

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# ------------------------------------------
# Security / JWT Configuration
# ------------------------------------------
# A secure, random 256-bit (or 512-bit) base64-encoded secret key for signing JWTs.
# You can generate one using: openssl rand -base64 32
JWT_SECRET_KEY=your_base64_encoded_256_bit_secret_key_here

# JWT expiration time in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ------------------------------------------
# Frontend Environment Variables (if needed)
# ------------------------------------------
# NOTE: Any variable prefixed with VITE_ will be bundled into the client code!
# Never place database passwords, JWT signing secrets, or private API keys here.
# VITE_API_BASE_URL=http://localhost:8080
